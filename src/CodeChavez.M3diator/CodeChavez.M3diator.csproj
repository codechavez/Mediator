<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Authors>Victor A Chavez</Authors>
		<Description>Super lightweight, yet powerful Mediator alternative. This follow a very basic implementation of the Mediator pattern from the Gang of Four programming book.</Description>
		<Copyright>Copyright 2026 Victor A Chavez</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>M3diator_128x128.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>CodeChavez.M3diator</PackageId>
		<Title>CodeChavez M3diator</Title>
		<Product>CodeChavez.M3diator</Product>
		<Version>1.0.2</Version>
		<PackageTags>CodeChavez,Mediator,M3diator,Helpers,Utilities,.net</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\assets\imgs\M3diator_128x128.png" Pack="true" PackagePath="" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
	  <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.18.0" />
	  <PackageReference Include="Scrutor" Version="7.0.0" />
	</ItemGroup>
</Project>
